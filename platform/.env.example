# ---- Postgres ----
POSTGRES_USER=claricase
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=claricase

# ---- Router ----
ROUTER_PORT=8080
PRIMARY_URL=http://svm-api:8000
LOG_LEVEL=INFO

# ---- svm-api ----
SVM_API_PORT=8000
MODEL_PATH=/app/docs/metrics/improved_model_1/model.joblib

# ---- OpenTelemetry (leave blank in P1 — Phase 7 fills this in) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# ---- Opt-in model services (docker compose --profile ensemble) ----
# To send traffic through the ensemble, set PRIMARY_URL=http://ensemble-api:8000
# above. Leave it on svm-api to serve improved_model_1 alone.
ENCODER_NAME=BAAI/bge-small-en-v1.5
SVM_API_URL=http://svm-api:8000
EMBED_API_URL=http://embed-api:8000
UPSTREAM_TIMEOUT_S=4.0
# Label-shift correction in ensemble-api: re-estimates the team mix from the
# last PRIOR_WINDOW stacker outputs, once PRIOR_MIN_ROWS have been seen,
# every PRIOR_REFRESH requests. Set LABEL_SHIFT_ENABLED=false to serve the
# stacker exactly as evaluated offline.
LABEL_SHIFT_ENABLED=true
PRIOR_WINDOW=5000
PRIOR_MIN_ROWS=500
PRIOR_REFRESH=100

# ---- Opt-in LLM stage (docker compose --profile agentic) ----
# Leave AGENTIC_URL empty to run without it. With it set, also raise
# PRIMARY_TIMEOUT_S (router) to about 12 so the extra calls fit.
AGENTIC_URL=
AGENTIC_TIMEOUT_S=3.0
AGENTIC_ISSUE_GAP=0.3
AGENTIC_BACKEND=openai_compat
AGENTIC_BASE_URL=https://api.groq.com/openai/v1
AGENTIC_API_KEY=
AGENTIC_MODEL=llama-3.3-70b-versatile
PRIMARY_TIMEOUT_S=5.0
