# ---- Postgres ----
POSTGRES_USER=claricase
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=claricase

# ---- Router ----
ROUTER_PORT=8080
PRIMARY_URL=http://svm-api:8000
# Tried once when PRIMARY_URL times out, is unreachable or returns 5xx.
# Leave empty to disable. With PRIMARY_URL=http://ensemble-api:8000, set this
# to http://svm-api:8000 so improved_model_1 answers if the ensemble is down.
FALLBACK_URL=
LOG_LEVEL=INFO

# ---- svm-api ----
SVM_API_PORT=8000
MODEL_PATH=/app/docs/metrics/improved_model_1/model.joblib

# ---- OpenTelemetry (leave blank in P1 — Phase 7 fills this in) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# ---- Opt-in model services (docker compose --profile ensemble) ----
# To send traffic through the ensemble, set PRIMARY_URL=http://ensemble-api:8000
# above. Leave it on svm-api to serve improved_model_1 alone.
ENCODER_NAME=BAAI/bge-small-en-v1.5
SVM_API_URL=http://svm-api:8000
EMBED_API_URL=http://embed-api:8000
UPSTREAM_TIMEOUT_S=4.0
# Label-shift correction in ensemble-api: re-estimates the team mix from the
# last PRIOR_WINDOW stacker outputs, once PRIOR_MIN_ROWS have been seen,
# every PRIOR_REFRESH requests. Set LABEL_SHIFT_ENABLED=false to serve the
# stacker exactly as evaluated offline.
LABEL_SHIFT_ENABLED=true
PRIOR_WINDOW=5000
PRIOR_MIN_ROWS=500
PRIOR_REFRESH=100

# ---- Opt-in LLM stage (docker compose --profile agentic) ----
# Leave AGENTIC_URL empty to run without it. With it set, also raise
# PRIMARY_TIMEOUT_S (router) to about 12 so the extra calls fit.
AGENTIC_URL=
AGENTIC_TIMEOUT_S=3.0
AGENTIC_ISSUE_GAP=0.3
AGENTIC_BACKEND=openai_compat
AGENTIC_BASE_URL=https://api.groq.com/openai/v1
AGENTIC_API_KEY=
AGENTIC_MODEL=llama-3.3-70b-versatile
PRIMARY_TIMEOUT_S=5.0

# ---- Explanations (ensemble-api, embed-api, router) ----
# ensemble-api builds explanations in the background and serves them on
# GET /explain/{request_id}; the router proxies that route to ENSEMBLE_API_URL.
# Set EXPLANATIONS_ENABLED=false to turn explanations off entirely.
EXPLANATIONS_ENABLED=true
ENSEMBLE_API_URL=http://ensemble-api:8000

# Narrator (ensemble-api). It reads only these EXPLAIN_* variables, never
# AGENTIC_*, AIC_*, GROQ_API_KEY or OPENAI_API_KEY. An empty value means
# "use the default" shown in brackets. Any invalid value disables the
# Narrator, and explanations then come from the template explainer.
# openai_compat | mock   [openai_compat]
EXPLAIN_BACKEND=
# [https://api.groq.com/openai/v1]
EXPLAIN_BASE_URL=
# Required when EXPLAIN_BACKEND=openai_compat   [none]
EXPLAIN_API_KEY=
# [llama-3.3-70b-versatile]
EXPLAIN_MODEL=
# Per-attempt timeout, 1 to 120 seconds   [30]
EXPLAIN_TIMEOUT_S=
# Comma-separated subset of consumer,agent   [consumer,agent]
EXPLAIN_AUDIENCES=
# Send the masked complaint text to the LLM: true | false   [true]
EXPLAIN_INCLUDE_TEXT=
# Shared secret for the X-ClariCase-Agent-Token header. Empty means no
# caller gets agent access.   [none]
EXPLAIN_AGENT_TOKEN=
# Output-token limit, 256 to 4096   [1024]
EXPLAIN_MAX_TOKENS=
# Mock backend only: faithful | unfaithful | failure_parse | failure_timeout   [faithful]
EXPLAIN_MOCK_MODE=
# Mock backend only: reply delay in seconds, >= 0   [0]
EXPLAIN_MOCK_DELAY_S=

# improved_model_2 sentence occlusion (embed-api). Not part of the Narrator config.
# true | false   [true]
EXPLAIN_OCCLUSION_ENABLED=
# Max extra encoder calls per complaint, 1 to 200   [20]
EXPLAIN_OCCLUSION_K=
# Product-first issue API (profile: issues). Choose a model supported by your
# provider; no model name is guessed. Use mock only for wiring checks.
ISSUE_BACKEND=openai_compat
ISSUE_BASE_URL=https://api.groq.com/openai/v1
ISSUE_API_KEY=
ISSUE_MODEL=
ISSUE_RESPONSE_FORMAT=json_object
ISSUE_TIMEOUT_S=25
ISSUE_CONCURRENCY=4
ISSUE_MAX_OUTPUT_TOKENS=800
ISSUE_PRODUCT_URL=http://ensemble-api:8000
ISSUE_PRODUCT_TIMEOUT_S=10
ISSUE_API_PORT=8081
