# Copy to .env (same folder) and fill in. .env is gitignored.

# ---- Agentic Issue Classifier ----
# Default backend is "groq"; set key below. Alternatives: openai | hf_local
AIC_LLM_BACKEND=groq
GROQ_API_KEY=
AIC_GROQ_MODEL=openai/gpt-oss-120b
# Optional override; leave blank to use ChatGroq's default endpoint.
# AIC_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Only used when AIC_LLM_BACKEND=openai
# OPENAI_API_KEY=
# AIC_OPENAI_MODEL=gpt-4o-mini

# Only used when AIC_LLM_BACKEND=hf_local
# AIC_HF_MODEL=google/flan-t5-large

# ---- Explanations: Narrator (src/explain/config.py) ----
# The Narrator reads only these EXPLAIN_* variables (never AIC_*, AGENTIC_*,
# GROQ_API_KEY or OPENAI_API_KEY). Lookup order: environment, then
# st.secrets, then the default in brackets. An empty value means "use the
# default". Any invalid value disables the Narrator, and explanations then
# come from the template explainer.
# openai_compat | mock   [openai_compat]
EXPLAIN_BACKEND=
# [https://api.groq.com/openai/v1]
EXPLAIN_BASE_URL=
# Required when EXPLAIN_BACKEND=openai_compat   [none]
EXPLAIN_API_KEY=
# [llama-3.3-70b-versatile]
EXPLAIN_MODEL=
# Per-attempt timeout, 1 to 120 seconds   [30]
EXPLAIN_TIMEOUT_S=
# Comma-separated subset of consumer,agent   [consumer,agent]
EXPLAIN_AUDIENCES=
# Send the masked complaint text to the LLM: true | false   [true]
EXPLAIN_INCLUDE_TEXT=
# Shared secret for the X-ClariCase-Agent-Token header. Empty means no
# caller gets agent access.   [none]
EXPLAIN_AGENT_TOKEN=
# Output-token limit, 256 to 4096   [1024]
EXPLAIN_MAX_TOKENS=
# Mock backend only: faithful | unfaithful | failure_parse | failure_timeout   [faithful]
EXPLAIN_MOCK_MODE=
# Mock backend only: reply delay in seconds, >= 0   [0]
EXPLAIN_MOCK_DELAY_S=

# ---- Explanations: improved_model_2 sentence occlusion ----
# IM2 explainer settings, not part of the Narrator config.
# true | false   [true]
EXPLAIN_OCCLUSION_ENABLED=
# Max extra encoder calls per complaint, 1 to 200   [20]
EXPLAIN_OCCLUSION_K=
